# E3 (2026-10-22): s2_sup_ul without the refusal class (17 classes, 6,580 pairs) — does the refusal class drive the propensity shift?
--objective suppress_ul
--lam 0.3
--sft_files data/sft/v2/sft_train.jsonl
--pair_files data/sft/v2/pairs_train.jsonl
--val_files data/sft/v2/sft_val.jsonl
--init_adapter outputs/train/sft_v2/adapter
--max_steps 300
--lr 5e-5
--sft_mix 0.5
--micro_batch 2
--accum 16
--grad_ckpt
--cache_dir data/cache
--pair_classes missing_required_arg dead_call redundant_read missing_call hallucinated_tool wrong_tool wrong_arg_type wrong_arg_value duplicate_write premature_answer unconfirmed_destructive ref_without_capability lookup_of_known_value stale_state_write unnecessary_call guessed_missing_info unbatched
