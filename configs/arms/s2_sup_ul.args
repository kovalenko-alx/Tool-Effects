--objective suppress_ul
--lam 0.3
--sft_files data/sft/v2/sft_train.jsonl
--pair_files data/sft/v2/pairs_train.jsonl
--val_files data/sft/v2/sft_val.jsonl
--init_adapter outputs/train/sft_v2/adapter
--max_steps 300
--lr 5e-5
--sft_mix 0.5
--micro_batch 2
--accum 16
--grad_ckpt
--cache_dir data/cache
